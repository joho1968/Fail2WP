#: fail2wp/fail2wp.php:771
msgid "Settings"
msgstr "Inställningar"

#: fail2wp/fail2wp.php:796
msgid "This feed has been disabled, please visit"
msgstr "Detta flöde har inaktiverats, vänligen besök"

#: fail2wp/fail2wp.php:800
msgid "Feed disabled"
msgstr "Flöde inaktiverat"

#: fail2wp/fail2wp.php:901
msgid "You are not currently logged in."
msgstr "Du är inte inloggad."

#: fail2wp/fail2wp.php:1026 fail2wp/fail2wp.php:1062 fail2wp/fail2wp.php:1077
#: fail2wp/fail2wp.php:1093 fail2wp/fail2wp.php:1114
msgid "No route was found matching the URL and request method."
msgstr ""
"Ingen route hittades som motsvarade webbadressen och metod för begäran."

#: fail2wp/fail2wp.php:1152 fail2wp/fail2wp.php:1163 fail2wp/fail2wp.php:1174
msgid "Invalid username, please try again."
msgstr "Ogiltigt användarnamn, försök igen."

#: fail2wp/fail2wp.php:1156 fail2wp/fail2wp.php:1203
msgid "Invalid e-mail address, please try again."
msgstr "Ogiltig e-postadress, försök igen."

#: fail2wp/fail2wp.php:1222
msgid "New user role default has been reset according to your"
msgstr "Förvald roll för nya användare har återställts enligt dina"

#: fail2wp/fail2wp.php:1226
msgid "settings"
msgstr "inställningar"

#: fail2wp/fail2wp.php:1245
msgid "Notification about new user role from"
msgstr "Avisering om ändring av förvald roll"

#: fail2wp/fail2wp.php:1247
msgid "This is a notification from"
msgstr "Detta är en avisering från"

#: fail2wp/fail2wp.php:1249
msgid ""
"The role for newly registered users has been reset to your configured "
"setting."
msgstr ""
"Den förvalda rollen för nya användare har återställts till den som du "
"konfigurerat."

#: fail2wp/fail2wp.php:1251
msgid "This notification was sent from the site"
msgstr "Denna avisering skickades från sajten"

#: fail2wp/fail2wp.php:1253
msgid "You may access the admin interface to the site here"
msgstr "Du når administrationsgränssnittet här"

#: fail2wp/fail2wp.php:1272
msgid "User registration is enabled, but the new user role does not match"
msgstr "Användarregistrering är aktiv, men den förvalda rollen matchar inte"

#: fail2wp/fail2wp.php:1287 fail2wp/fail2wp.php:1320 fail2wp/fail2wp.php:1352
msgid "Go to"
msgstr "Gå till"

#: fail2wp/fail2wp.php:1289 fail2wp/fail2wp.php:1322 fail2wp/fail2wp.php:1354
msgid "General settings"
msgstr "Allmänna inställningar"

#: fail2wp/fail2wp.php:1291 fail2wp/fail2wp.php:1324 fail2wp/fail2wp.php:1356
msgid "to check your membership and new user settings."
msgstr "för att kontrollera inställningarna för medlemsskap och nya användare."

#: fail2wp/fail2wp.php:1310
msgid "User registration is enabled, and new users will be administrators"
msgstr "Användarregistrering är aktiv och nya användare blir administratörer"

#: fail2wp/fail2wp.php:1342
msgid "User registration is enabled, but no role has been configured"
msgstr ""
"Användarregistrering är aktiv, men ingen förvald roll har konfigurerats"

#: fail2wp/fail2wp.php:1445 fail2wp/fail2wp.php:1450
msgid "Unknown role"
msgstr "Okänd roll"

#: fail2wp/fail2wp.php:1503
msgid ""
"Provides authentication security functions for WordPress, plays nicely with "
"Fail2ban and Cloudflare"
msgstr ""
"Tillhandahåller autentiseringsloggning och säkerhetsfunktioner för "
"WordPress, fungerar även bra med Fail2ban och Cloudflare"

#: fail2wp/fail2wp.php:1506
msgid "Basic configuration"
msgstr "Baskonfiguration"

#: fail2wp/fail2wp.php:1509
msgid "Login IP"
msgstr "IP-kontroll"

#: fail2wp/fail2wp.php:1512
msgid "IP blocking"
msgstr "IP-blockering"

#: fail2wp/fail2wp.php:1515
msgid "New users"
msgstr "Nya användare"

#: fail2wp/fail2wp.php:1518
msgid "Admin monitor"
msgstr "Administratörsövervakning"

#: fail2wp/fail2wp.php:1521 fail2wp/fail2wp.php:2331
msgid "User logging"
msgstr "Loggning"

#: fail2wp/fail2wp.php:1524
msgid "REST API"
msgstr "REST API"

#: fail2wp/fail2wp.php:1527
msgid "XMLRPC"
msgstr "XMLRPC"

#: fail2wp/fail2wp.php:1530
msgid "Advanced"
msgstr "Avancerat"

#: fail2wp/fail2wp.php:1533
msgid "Cloudflare"
msgstr "Cloudflare"

#: fail2wp/fail2wp.php:1536
msgid "Import/Export"
msgstr "Import/Export"

#: fail2wp/fail2wp.php:1539
msgid "About"
msgstr "Om"

#: fail2wp/fail2wp.php:1544
msgid ""
"One or more of openlog(), closelog(), and/or syslog() seem to be missing on "
"this system"
msgstr ""
"En eller flera av openlog(), closelog(), och/eller syslog() verkar saknas på "
"detta system"

#: fail2wp/fail2wp.php:1568
msgid ""
"Some data was filtered, please make sure you paste the content exactly as "
"copied"
msgstr ""
"Data har filtrerats, kontrollera att du klistrar in innehållet exakt som det "
"kopierades"

#: fail2wp/fail2wp.php:1573 fail2wp/fail2wp.php:1581
msgid "Please make sure you paste the content exactly as copied"
msgstr "Kontrollera att du klistrar in innehållet exakt som det kopierades"

#: fail2wp/fail2wp.php:1586
msgid ""
"Plugin version mismatch. You can only import exported data from the same "
"version as the one currently installed"
msgstr ""
"Versionerna matchar inte varandra. Du kan bara importera exporterat data "
"från samma version som den som är installerad"

#: fail2wp/fail2wp.php:1659
msgid "The following settings were ignored during the import"
msgstr "Följande inställningar ignorerades vid importen"

#: fail2wp/fail2wp.php:1666
msgid "Settings were successfully imported"
msgstr "Inställningarna har importerats"

#: fail2wp/fail2wp.php:1670
msgid "The setting \"Site label\" may need manual correction"
msgstr "Inställningen \"Webbplatsnamn\" kan behöva korrigeras"

#: fail2wp/fail2wp.php:1677
msgid ""
"This tab can be used to import and export plugin settings and active IP-"
"blocking bans."
msgstr ""
"Den här fliken kan användas för att importera och exportera tilläggets "
"inställningar och aktiva IP-blockeringar."

#: fail2wp/fail2wp.php:1681 fail2wp/fail2wp.php:1690
msgid "Import settings"
msgstr "Importera inställningar"

#: fail2wp/fail2wp.php:1686
msgid "Paste settings in this field to import them"
msgstr "Klistra in inställningarna i detta fält för att importera dem"

#: fail2wp/fail2wp.php:1695
msgid "Export settings"
msgstr "Exportera inställningar"

#: fail2wp/fail2wp.php:1758
msgid "Unable to create data for export"
msgstr "Kunde inte skapa data för export"

#: fail2wp/fail2wp.php:1766
msgid ""
"Copy the text in this field to export your settings and active IP-blocking "
"bans to another site"
msgstr ""
"Kopiera texten i detta fält för att exportera dina inställningar och aktiva "
"IP-blockeringar till en annan webbplats"

#: fail2wp/fail2wp.php:1804
msgid ""
"This is logged to the system's authentication log, which allows Fail2ban to "
"dynamically block offending IP addresses."
msgstr ""
"Detta loggas till systemetes autentiseringslogg, som gör det möjligt för "
"Fail2ban att på dynamisk väg blockera IP-adresser."

#: fail2wp/fail2wp.php:1806
msgid ""
"Configuration of the Fail2ban system daemon, or similar, must be done "
"outside of WordPress for this to have any effect."
msgstr ""
"Konfiguration av Fail2ban, eller liknande, måste göras utanför WordPress för "
"att dessa inställningar skall ha någon effekt."

#: fail2wp/fail2wp.php:1849
msgid "Thank you for installing"
msgstr "Tack för att du installerat"

#: fail2wp/fail2wp.php:1850
msgid ""
"This plugin provides security functions and integration between WordPress and"
msgstr ""
"Detta plugin tillhandahåller säkerhetsfunktioner samt integration mellan "
"WordPress och"

#: fail2wp/fail2wp.php:1854
msgid "Commercial support and customizations for this plugin is available from"
msgstr ""
"Kommersiell support och anpassningar av detta tillägg tillhandahålls av"

#: fail2wp/fail2wp.php:1856
msgid "(Sweden). We speak Swedish and English"
msgstr "Vi pratar svenska och engelska"

#: fail2wp/fail2wp.php:1858
msgid ""
"The plugin is written by Joaquim Homrighausen and sponsored by WebbPlatsen i "
"Sverige AB."
msgstr ""
"Detta tillägg är utvecklat av Joaquim Homrighausen och sponsrat av "
"WebbPlatsen i Sverige AB."

#: fail2wp/fail2wp.php:1860
msgid ""
"If you find this plugin useful, the author is happy to receive a donation, "
"good review, or just a kind word."
msgstr ""
"Om du tycker detta tillägg är användbart så uppskattar utvecklaren en "
"donation, bra omdöme och/eller positiv kommentar."

#: fail2wp/fail2wp.php:1861
msgid ""
"If there is something you feel to be missing from this plugin, or if you "
"have found a problem with the code or a feature, please do not hesitate to "
"reach out to"
msgstr ""
"Om du anser att något saknas i detta tillägg eller om du har hittat ett fel "
"i koden eller en funktion, tveka inte att höra av dig till"

# ; fail2wp.php:1357
#: fail2wp/fail2wp.php:1865
msgid "There is more documentation available at"
msgstr "Det finns mer dokumentation på"

#: fail2wp/fail2wp.php:1870
msgid "Other plugins"
msgstr "Andra tillägg"

#: fail2wp/fail2wp.php:1874
msgid ""
"Plugin that provides integration with Mattermost, including notifications "
"and OAuth2 authentication"
msgstr ""
"Ett tillägg som integrerar WordPress med Mattermost, inklusive aviseringar "
"och OAuth2-autentisering"

#: fail2wp/fail2wp.php:1879
msgid "Plugin that provides uncomplicated 2FA protection"
msgstr "Ett tillägg som tillhandahåller okomplicerat 2FA-skydd"

#: fail2wp/fail2wp.php:1884
msgid "Plugin that provides uncomplicated map functionality"
msgstr "Ett tillägg som tillhandahåller okomplicerad kartfunktionalitet"

#: fail2wp/fail2wp.php:2125
#, php-format
msgid ""
"The following bypass entries were not saved because they are invalid: %s"
msgstr "Följande undantagsposter sparades inte eftersom de är ogiltiga: %s"

#: fail2wp/fail2wp.php:2145
msgid ""
"The site name to use for logging, defaults to your site name if left empty"
msgstr ""
"Namn för webbplatsen att använda för loggning, hämtas från WordPress om "
"fältet är tomt"

#: fail2wp/fail2wp.php:2171
msgid "Unknown users"
msgstr "Okända användare"

#: fail2wp/fail2wp.php:2178
msgid ""
"User enumeration attempts (i.e. your.site/...?author=nnn or /wp-json/wp/v2/"
"users)"
msgstr ""
"Försök att hämta användarnamn (t ex din.sajt.../?author=nnn eller /wp-json/"
"wp/v2/users)"

#: fail2wp/fail2wp.php:2187
msgid "These settings allows you to allow or block logins from IP addresses."
msgstr ""
"Dessa inställnignar låter dig blockera eller tillåta inloggningar från IP-"
"adresser"

#: fail2wp/fail2wp.php:2189
msgid ""
"You may enter single IPv4 and IPv6 addresses, addresses in CIDR notation, "
"and/or fully qualified hostnames."
msgstr ""
"Du kan ange enstaka IPv4- och IPv6-adresser, IP-adresser i CIDR-format och/"
"eller värdnamn."

#: fail2wp/fail2wp.php:2191
msgid ""
"Hostnames will be resolved to IP addresses. If you have enabled checking for "
"Cloudflare IPs, it will be taken into consideration."
msgstr ""
"Värdnamn kommer att slås upp för att få IP-adresser. Om du har aktiverat "
"hantering av Cloudflare IP-adresser, så kommer det att tas i beaktande."

#: fail2wp/fail2wp.php:2193
msgid ""
"You may also use wildcard*.hostna??.com, in which case a reverse name lookup "
"is performed based on the visitor's IP address."
msgstr ""
"Du kan också använda wildcard*.hostna??.com, vilket kommer att tvinga ett "
"omvänt DNS-uppslag baserat på besökarens IP-adress."

#: fail2wp/fail2wp.php:2197
msgid "Please make sure your IP address or hostname is on the allow list"
msgstr ""
"Vänligen se till att den IP-adress eller värdnamn du nu använder finns i "
"tillåt-listan"

#: fail2wp/fail2wp.php:2205
msgid "Indicated remote IP address"
msgstr "Indikerad IP-adress för besökare"

#: fail2wp/fail2wp.php:2209
msgid "Indicated Cloudflare IP address"
msgstr "Indikerad Cloudflare IP-adress"

#: fail2wp/fail2wp.php:2213
msgid "Indicated proxy addresses"
msgstr "Indikerad proxyadress"

#: fail2wp/fail2wp.php:2222
msgid "enable IP address access control for logins"
msgstr "aktivera IP-adresskontroll för inloggningar"

#: fail2wp/fail2wp.php:2229
msgid ""
"enable test mode. This will log failures to the PHP error log, but not "
"actually block the login"
msgstr ""
"aktivera testläge. Om det är aktiverat så loggas inloggningar som skulle ha "
"blockerats till PHP-loggen, men inloggningen kommer inte att blockeras"

#: fail2wp/fail2wp.php:2237
msgid ""
"notify fail2ban about failed login attempts based on IP login rules, "
"automatically disabled if test mode is enabled"
msgstr ""
"informera fail2ban vid misslyckade inloggningsförsök pga IP-blockering, "
"automatiskt avstängd om testläge är aktiverat"

#: fail2wp/fail2wp.php:2244
msgid "minutes (0-10080)"
msgstr "minuter (0-10080)"

#: fail2wp/fail2wp.php:2252
msgid "IPs matching these addresses will be allowed to login"
msgstr "IP-adresser som matchar adresser här kommer att kunna logga in"

#: fail2wp/fail2wp.php:2253
msgid ""
"If this list is used, and the remote IP address does not match an entry "
"here, the login will be denied"
msgstr ""
"Om denna lista används, och besökarens IP-adress inte matchar någon av "
"posterna här, så kommer inloggning inte tillåtas"

#: fail2wp/fail2wp.php:2260
msgid "IPs matching these addresses will be prevented from logging in"
msgstr "IP-adresser som matchar adresser här kommer inte att kunna logga in"

#: fail2wp/fail2wp.php:2266
msgid ""
"Temporarily blocks an exact client IP after it reaches the configured number "
"of security events. Only events that Fail2WP is configured to log contribute "
"to this counter."
msgstr ""
"Blockerar tillfälligt en exakt klient-IP när den når det angivna antalet "
"säkerhetshändelser. Endast händelser som Fail2WP är konfigurerat att logga "
"räknas."

#: fail2wp/fail2wp.php:2267
msgid ""
"Cloudflare client-IP unmasking is applied before counting and blocking. "
"Login allow-list matches retain precedence on the login endpoint."
msgstr ""
"Cloudflares avmaskning av klient-IP utförs före räkning och blockering. "
"Träffar i inloggningens tillåt-lista har företräde vid inloggning."

#: fail2wp/fail2wp.php:2268
msgid ""
"Bypass hostname and wildcard entries use DNS lookups. Prefer exact IP "
"addresses or CIDR ranges when possible to avoid lookup latency."
msgstr ""
"Värdnamn och jokertecken i undantagslistan använder DNS-uppslag. Använd om "
"möjligt exakta IP-adresser eller CIDR-intervall för att undvika "
"fördröjningar vid uppslag."

#: fail2wp/fail2wp.php:2270 fail2wp/fail2wp.php:2501 fail2wp/fail2wp.php:2505
#: fail2wp/fail2wp.php:2536
msgid "NOTE"
msgstr "OBS!"

#: fail2wp/fail2wp.php:2270
msgid ""
"No persistent object cache is available. IP blocking still works, but each "
"sitewide ban check may require a database lookup."
msgstr ""
"Ingen beständig objektcache är tillgänglig. IP-blockering fungerar "
"fortfarande, men varje kontroll av blockering för hela webbplatsen kan kräva "
"ett databasuppslag."

#: fail2wp/fail2wp.php:2274
msgid "Enable temporary sitewide IP blocking"
msgstr "Aktivera tillfällig IP-blockering för hela webbplatsen"

#: fail2wp/fail2wp.php:2278
msgid "Security events from one IP before a ban is created."
msgstr "Säkerhetshändelser från en IP-adress innan en blockering skapas."

#: fail2wp/fail2wp.php:2281 fail2wp/fail2wp.php:2285 fail2wp/fail2wp.php:2788
msgid "seconds"
msgstr "sekunder"

#: fail2wp/fail2wp.php:2282
msgid "Time period in which events are counted."
msgstr "Tidsperioden under vilken händelser räknas."

#: fail2wp/fail2wp.php:2286
msgid "How long a new or refreshed ban remains active."
msgstr "Hur länge en ny eller förnyad blockering förblir aktiv."

#: fail2wp/fail2wp.php:2290
msgid ""
"Exact IPv4/IPv6 addresses, CIDR ranges, hostnames, or hostname wildcards "
"that must never be blocked. Enter one entry per line; for example, "
"192.0.2.15, 192.0.2.0/24, admin.example.com, or *.defsol.com."
msgstr ""
"Exakta IPv4-/IPv6-adresser, CIDR-intervall, värdnamn eller värdnamn med "
"jokertecken som aldrig ska blockeras. Ange en post per rad, exempelvis "
"192.0.2.15, 192.0.2.0/24, admin.example.com eller *.defsol.com."

#: fail2wp/fail2wp.php:2296
msgid ""
"Monitors administrator-role accounts and reports unexpected changes. It is a "
"detection feature and cannot guarantee prevention against a compromised "
"administrator account or direct database changes."
msgstr "Övervakar konton med administratörsrollen och rapporterar oväntade ändringar. Funktionen är avsedd för upptäckt och kan inte garantera skydd mot ett komprometterat administratörskonto eller direkta databasändringar."

#: fail2wp/fail2wp.php:2297
msgid ""
"Changes are checked immediately when WordPress user and role hooks run, then "
"reconciled hourly through WP-Cron. Configure a real server cron or system "
"timer for reliable scheduled checks on low-traffic sites."
msgstr "Ändringar kontrolleras omedelbart när WordPress användar- och rollhookar körs och stäms sedan av varje timme med WP-Cron. Konfigurera en riktig server-cron eller systemtimer för tillförlitliga schemalagda kontroller på webbplatser med låg trafik."

#: fail2wp/fail2wp.php:2300
msgid "Monitor administrator accounts and log unexpected changes"
msgstr "Övervaka administratörskonton och logga oväntade ändringar"

#: fail2wp/fail2wp.php:2308
msgid ""
"No administrator baseline has been recorded yet. Saving this setting enabled "
"or reviewing the current accounts will establish one."
msgstr "Ingen baslinje för administratörskonton har registrerats ännu. Om du sparar inställningen som aktiverad eller granskar de aktuella kontona skapas en."

#: fail2wp/fail2wp.php:2310
msgid "The current administrator accounts differ from the stored baseline."
msgstr "De aktuella administratörskontona skiljer sig från den sparade baslinjen."

#: fail2wp/fail2wp.php:2312
msgid "The current administrator accounts match the stored baseline."
msgstr "De aktuella administratörskontona matchar den sparade baslinjen."

#: fail2wp/fail2wp.php:2316
msgid "Review and update baseline"
msgstr "Granska och uppdatera baslinje"

#: fail2wp/fail2wp.php:2317
msgid ""
"Use this only after intentionally creating, removing, or changing "
"administrator accounts."
msgstr "Använd detta endast efter att du avsiktligt har skapat, tagit bort eller ändrat administratörskonton."

#: fail2wp/fail2wp.php:2324
msgid "These settings will disable and/or monitor XMLRPC calls to this site"
msgstr ""
"Dessa inställningar kan användas för att stänga av eller övervaka XMLRPC-"
"anrop till sajten"

#: fail2wp/fail2wp.php:2327
msgid ""
"Please make sure you understand how these settings can impact the operation "
"of WordPress and other plugins before making changes to them"
msgstr ""
"Var säker på att du förstår hur dessa inställningar kan påverka WordPress "
"och andra tillägg innan du ändrar dem"

#: fail2wp/fail2wp.php:2330
msgid ""
"If an authenticated XMLRPC call fails due to an unknown username or invalid "
"password, it will be handled by Fail2WP as a failed user login attempt"
msgstr ""
"Om ett autentiserat XMLRPC-anrop misslyckas pga ett okänt användarnamn "
"ellerlösenord, så kommer Fail2WP hantera det som ett misslyckat "
"inloggninsförsök"

#: fail2wp/fail2wp.php:2331
msgid "Please see \""
msgstr "Vänligen se \""

#: fail2wp/fail2wp.php:2331
msgid "to configure applicable options"
msgstr "för att konfigurera relevanta inställningar"

#: fail2wp/fail2wp.php:2334
msgid ""
"If XMLRPC pingbacks are disabled, the following XMLRPC methods are removed"
msgstr ""
"Om XMLRPC-pingbacks är avsträngt så kommer följande XMLRPC-metoder "
"inaktiveras"

#: fail2wp/fail2wp.php:2342
msgid "disable authenticated XMLRPC calls"
msgstr "stäng av XMLRPC-funktionalitet som kräver autentisering"

#: fail2wp/fail2wp.php:2343 fail2wp/fail2wp.php:2351
msgid "This will not notify fail2ban"
msgstr "Detta informerar inte fail2ban"

#: fail2wp/fail2wp.php:2350
msgid "disable XMLRPC pingbacks"
msgstr "stäng av XMLRPC-pingbacks"

#: fail2wp/fail2wp.php:2358
msgid "disable XMLRPC completely"
msgstr "stäng av all XMLRPC-funktionalitet"

#: fail2wp/fail2wp.php:2365
msgid "notify fail2ban about failed XMLRPC activity when completely disabled"
msgstr ""
"informera fail2ban om XMLRPC-aktivitet när all XMLRPC-funktionalitet är "
"avstängd"

#: fail2wp/fail2wp.php:2373
msgid "Warn about odd membership/registration settings"
msgstr "Varna för udda medlemsskap-/registreringsinställningar"

#: fail2wp/fail2wp.php:2391
msgid "Check WordPress setting against the value configured here"
msgstr "Jämför WordPress inställning med det som konfigurerats här"

#: fail2wp/fail2wp.php:2395 fail2wp/fail2wp.php:2424
msgid "No available roles (?)"
msgstr "Inga tillgängliga roller (?)"

#: fail2wp/fail2wp.php:2403
msgid "Force new user registration settings to a role"
msgstr "Tvinga inställningen för nya användare till en roll"

#: fail2wp/fail2wp.php:2421
msgid "Force WordPress setting to the value configured here"
msgstr "Tvinga WordPress-inställning till värdet som konfigurerats här"

#: fail2wp/fail2wp.php:2430
msgid "Minimum length of usernames, 2-200 characters, 0 ignores the setting"
msgstr ""
"Minsta antal tecken för användarnamn, 2-200 tecken, 0 avaktiverar kontrollen"

#: fail2wp/fail2wp.php:2436
msgid "These usernames will be blocked for new user registrations"
msgstr "Dessa användarnamn blockeras vid registrering av nya användare"

#: fail2wp/fail2wp.php:2442
msgid "E-mail address must match at least one of these for new users"
msgstr "E-postadressen för nya användare måste matcha en av dessa"

#: fail2wp/fail2wp.php:2448
msgid "Remove \"Generator\" output in HTML, RSS, etc."
msgstr "Ta bort \"Generator\"-info från HTML, RSS, etc."

#: fail2wp/fail2wp.php:2455
msgid "Remove RSS and Atom feeds"
msgstr "Inaktiverar RSS- och Atom-flöden"

#: fail2wp/fail2wp.php:2463
msgid "Remove all plugin settings and data when plugin is uninstalled"
msgstr "Ta bort alla inställningar när tillägget avinstalleras"

#: fail2wp/fail2wp.php:2470
msgid ""
"Block user enumeration attempts (i.e. your.site/...?author=nnn or /wp-json/"
"wp/v2/users)"
msgstr ""
